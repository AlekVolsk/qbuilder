# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.php text eol=lf
*.phpt text eol=lf
*.phpcs text eol=lf
*.phpt text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Exclude from export
/.gitattributes export-ignore
/.gitignore export-ignore
/.phpstan export-ignore
/.php-cs-fixer.cache export-ignore
/testo.php export-ignore
/phpstan.neon.dist export-ignore
/phpcs.xml.dist export-ignore
/.php-cs-fixer.dist.php export-ignore
/tests export-ignore
/tools export-ignore
/vendor export-ignore
/.idea export-ignore
/.vscode export-ignore
/build-dev export-ignore
/coverage export-ignore
/coverage.xml export-ignore
/COVERAGE_ANALYSIS.md export-ignore

