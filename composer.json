{
    "name": "alekvolsk/qbuilder",
    "description": "SQL Query Builder with fluent interface supporting multiple database drivers (MySQL, PostgreSQL, SQLite, MSSQL, Oracle, ClickHouse)",
    "type": "library",
    "keywords": [
        "sql",
        "query-builder",
        "database",
        "mysql",
        "postgresql",
        "sqlite",
        "mssql",
        "oracle",
        "clickhouse"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksey Morozov",
            "email": "alekvolsk@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/alekvolsk/qbuilder",
    "require": {
        "php": ">=8.4"
    },
    "suggest": {
        "ext-pdo": "PDO extension for database connectivity (required for actual database operations)",
        "ext-pdo_mysql": "PDO MySQL driver for MySQL/MariaDB support",
        "ext-pdo_pgsql": "PDO PostgreSQL driver for PostgreSQL support",
        "ext-pdo_sqlite": "PDO SQLite driver for SQLite support",
        "ext-pdo_oci": "PDO Oracle driver for Oracle Database support",
        "ext-pdo_dblib": "PDO dblib driver for MS SQL Server support",
        "ext-pcov": "PCOV extension for code coverage analysis (recommended for faster coverage)"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.31",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan-strict-rules": "^2.0",
        "shipmonk/dead-code-detector": "^1.4",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "testo/testo": "^0.10.55"
    },
    "autoload": {
        "psr-4": {
            "QBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QBuilder\\Tests\\": "tests/",
            "QBuilder\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:integration": "testo --suite=Integration",
        "test:coverage-clover": "testo --coverage --coverage-clover=build-dev/coverage/clover.xml",
        "phpstan": "phpstan analyse",
        "phpstan:baseline": "phpstan analyse --generate-baseline",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@cs-check",
            "@phpcs",
            "@phpstan"
        ]
    },
    "support": {
        "issues": "https://github.com/alekvolsk/qbuilder/issues",
        "source": "https://github.com/alekvolsk/qbuilder"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
